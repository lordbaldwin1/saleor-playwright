# Saleor service URLs (defaults match saleor-platform + storefront dev)
SALEOR_API_URL=http://localhost:8000/graphql/
SALEOR_API_HEALTH_URL=http://localhost:8000/health/
SALEOR_DASHBOARD_URL=http://localhost:9000/
SALEOR_STOREFRONT_URL=http://localhost:3000/

# Default credentials from: docker compose run --rm api python3 manage.py populatedb --createsuperuser
SALEOR_ADMIN_EMAIL=admin@example.com
SALEOR_ADMIN_PASSWORD=admin

# Storefront channel slug (from populatedb / Dashboard → Configuration → Channels)
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Dummy payment app (storefront checkout) — runs on host port 3001 (storefront uses 3000)
DUMMY_PAYMENT_APP_PORT=3001
# URL Saleor Docker containers use to reach the app (do not change unless you know why)
DUMMY_PAYMENT_APP_API_URL=http://host.docker.internal:3001
DUMMY_PAYMENT_APP_IFRAME_URL=http://localhost:3001
# Hostname embedded in appInstall manifestUrl (Saleor worker fetches from inside Docker)
DUMMY_PAYMENT_APP_MANIFEST_HOST=host.docker.internal

# Set to 1 to have Playwright start Docker + storefront before tests (local dev: often leave unset and run saleor:up / storefront:dev yourself)
# E2E_START_SERVERS=1
